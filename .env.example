# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored — never commit real credentials.

# Django signing key. Generate a strong random value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# settings.py falls back to an INSECURE development key if this is unset.
SECRET_KEY=replace-with-a-long-random-secret-key

# Supabase PostgreSQL connection string (from Supabase → Project Settings → Database → URI).
# If this is left blank/unset, the app falls back to a local SQLite database (db.sqlite3).
# Example format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase project URL (informational; the Django ORM connects via DATABASE_URL).
# Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# --- Production-only settings (see docs/DEPLOYMENT.md) ---
# Set these to False / your real domain before exposing the app publicly.
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=ayudamap.example.com,www.ayudamap.example.com
