# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored — never commit real credentials.

# Django signing key. Generate a strong random value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# A real key is required whenever debug is off.
SECRET_KEY=

# This template is for local development. Set DJANGO_DEBUG=False in production.
DJANGO_DEBUG=True

# Supabase PostgreSQL connection string (from Supabase → Project Settings → Database → URI).
# Required in production. Leaving it blank in debug mode uses local SQLite.
# Example format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase project URL (informational; the Django ORM connects via DATABASE_URL).
# Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# CARTO Basemaps API key for Leaflet light (Voyager) and dark (Dark Matter) tiles.
# Free non-commercial keys: https://carto.com/basemaps/apikey
# If left blank, maps fall back to standard OpenStreetMap tiles.
CARTO_API_KEY=

# --- Production-only settings (see docs/DEPLOYMENT.md) ---
# Required with debug off; use a comma-separated list without schemes or ports.
# DJANGO_ALLOWED_HOSTS=ayudamap.example.com,www.ayudamap.example.com
# Only enable behind a trusted proxy that overwrites X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_HTTPS=True
# Absolute path to a persistent volume for profile uploads.
# DJANGO_MEDIA_ROOT=/var/lib/ayudamap/media
